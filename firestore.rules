rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == role;
    }
    function isTeacher() { return hasRole('teacher'); }
    function isParent() { return hasRole('parent'); }
    function isAdmin() { return hasRole('admin'); }
    function isAuthorizedForStudent(studentId) {
      return isOwner(studentId) || isTeacher() || isParent() || isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow write: if isOwner(userId);
      allow read: if isAuthorizedForStudent(userId);
    }
    
    match /profiles/{userId} {
      allow write: if isOwner(userId);
      allow read: if isAuthorizedForStudent(userId);
    }

    match /subscriptions/{userId} {
      allow write: if isOwner(userId);
      allow read: if isAuthorizedForStudent(userId);
    }
    
    match /usageLimits/{userId} {
      allow write: if isOwner(userId);
      allow read: if isAuthorizedForStudent(userId);
    }

    match /quizAttempts/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /examAttempts/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /mistakes/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /weaknesses/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /studyPlans/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /studySessions/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /revisionItems/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /notes/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /aiConversations/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /aiMessages/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /bookmarks/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /achievements/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    match /notifications/{docId} {
      allow update, delete: if isOwner(resource.data.userId);
      allow read: if isAuthorizedForStudent(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    match /subjects/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /chapters/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /topics/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /questions/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
